repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v6.0.0
    hooks:
      - id: check-added-large-files
      - id: check-illegal-windows-names
      - id: check-json
      - id: check-merge-conflict
      - id: check-toml
      - id: check-yaml
      - id: end-of-file-fixer
{% if stack == 'unity' %}
        exclude: '\.(unity|prefab|asset|mat|controller|overrideController|inputactions|playable|anim|meta)$'
{% endif %}
      - id: trailing-whitespace
{% if stack == 'unity' %}
        exclude: '\.(unity|prefab|asset|mat|controller|overrideController|inputactions|playable|anim|meta)$'
{% endif %}
  - repo: https://github.com/gitleaks/gitleaks
    rev: v8.30.1
    hooks:
      - id: gitleaks-system
        pass_filenames: false
{% if stack == 'python' %}
  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.17.2
    hooks:
      - id: ruff-check
        args: [--fix]
      - id: ruff-format
{% elif stack == 'typescript' %}
  - repo: local
    hooks:
      - id: tsc
        name: tsc
        entry: npx tsc --noEmit
        language: system
        pass_filenames: false
      - id: eslint
        name: eslint
        entry: npx eslint --max-warnings=0
        language: system
        files: '\.(ts|tsx|js|mjs)$'
      - id: prettier
        name: prettier
        entry: npx prettier --check
        language: system
        files: '^(src/.*\.(ts|tsx|js|mjs|json|css|html|md)|index\.html)$'
{% elif stack == 'dotnet' %}
  - repo: local
    hooks:
      - id: dotnet-format
        name: dotnet format
        entry: dotnet format DevFlow.slnx --verify-no-changes --severity warn --include
        language: system
        files: '\.cs$'
{% elif stack == 'unity' %}
  - repo: local
    hooks:
      - id: unity-integrity
        name: unity integrity
        entry: uvx --from git+https://github.com/{{ owner }}/dev-platform@{{ platform_ref }}#subdirectory=cli devctl unity integrity
        language: system
        pass_filenames: false
        files: '^(Assets|Packages|ProjectSettings)/'
{% endif %}
