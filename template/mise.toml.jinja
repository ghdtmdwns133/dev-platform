[tools]
{% if stack == 'python' %}
python = "3.12"
{% elif stack == 'typescript' %}
node = "22"
{% elif stack == 'dotnet' %}
dotnet = "10.0.401"
{% endif %}
uv = "0.12.21"
pre-commit = { version = "4.7.0", python = "3.12" }
"aqua:gitleaks/gitleaks" = "8.30.1"

{% if stack == 'python' %}
[tasks.check]
run = [
  "uv sync --frozen",
  "pre-commit run --all-files",
]

[tasks.test]
run = "uv run --frozen pytest -q --cov --cov-report=xml:coverage/coverage.xml --cov-report=term-missing --cov-fail-under={{ min_coverage }}"

[tasks.build]
run = "uv build --out-dir dist"
{% elif stack == 'typescript' %}
[tasks.check]
run = [
  "npm ci --no-audit --no-fund",
  "pre-commit run --all-files",
]

[tasks.test]
run = [
  "npm ci --no-audit --no-fund",
  "npx vitest run --coverage",
]

[tasks.build]
run = [
  "npm ci --no-audit --no-fund",
  "npm run build",
]
{% elif stack == 'dotnet' %}
[tasks.check]
run = [
  "dotnet restore DevFlow.slnx",
  "pre-commit run --all-files",
]

[tasks.test]
run = "dotnet test DevFlow.slnx --collect:\"XPlat Code Coverage\" --results-directory coverage"

[tasks.build]
run = "dotnet pack DevFlow.slnx -c Release -o dist"
{% else %}
[tasks.check]
run = "pre-commit run --all-files"
{% endif %}
