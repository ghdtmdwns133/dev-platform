name: Nightly

on:
  schedule:
    - cron: "0 3 * * *"
  workflow_dispatch: {}

permissions:
  contents: read

concurrency:
  group: {% raw %}nightly-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  platform-nightly:
    name: platform-nightly
    permissions:
      contents: read
      issues: write
{% if stack == 'unity' %}
      security-events: write
      actions: read
    uses: {{ owner }}/dev-platform/.github/workflows/unity.yml@{{ platform_ref }}
    with:
      unity-runner: {{ 'none' if visibility == 'public' else 'self-hosted' }}
      build: {{ 'false' if visibility == 'public' else 'true' }}
      platform-ref: {{ platform_ref }}
{% else %}
    uses: {{ owner }}/dev-platform/.github/workflows/nightly.yml@{{ platform_ref }}
    with:
      working-directory: "."
      enable-codecov: false
{% endif %}
