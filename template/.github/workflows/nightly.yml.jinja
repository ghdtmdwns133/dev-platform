name: Nightly

on:
  schedule:
    - cron: "0 3 * * *"
  workflow_dispatch: {}

permissions:
  contents: read

concurrency:
  group: {% raw %}nightly-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  platform-nightly:
    name: platform-nightly
    permissions:
      contents: read
      issues: write
{% if stack == 'unity' %}
      security-events: write
      actions: read
    uses: {{ owner }}/dev-platform/.github/workflows/unity.yml@{{ platform_ref }}
    with:
      unity-runner: {{ unity_runner }}
{% if unity_runner == 'self-hosted' %}
      build: true
{% endif %}
      platform-ref: {{ platform_ref }}
{% if unity_runner == 'uba' %}
    secrets:
      unity_build_api_key: {% raw %}${{ secrets.UNITY_BUILD_API_KEY }}{% endraw %}
      unity_build_org_id: {% raw %}${{ secrets.UNITY_BUILD_ORG_ID }}{% endraw %}
      unity_build_project_id: {% raw %}${{ secrets.UNITY_BUILD_PROJECT_ID }}{% endraw %}
{% endif %}
{% else %}
    uses: {{ owner }}/dev-platform/.github/workflows/nightly.yml@{{ platform_ref }}
    with:
      working-directory: "."
      enable-codecov: false
{% endif %}
