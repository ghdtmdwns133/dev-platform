name: CI

on:
  push:
    branches: ["**"]
  pull_request: {}
  workflow_dispatch: {}

permissions:
  contents: read

concurrency:
  group: {% raw %}ci-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
{% raw %}
  changes:
    name: changes
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: read
    outputs:
      code: ${{ steps.paths.outputs.code }}
      docs: ${{ steps.paths.outputs.docs }}
      docs_files: ${{ steps.paths.outputs.docs_files }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          # dorny/paths-filter fetches the base branch on push events, including
          # the first push of a private branch. This token is read-only.
          persist-credentials: true
      - uses: dorny/paths-filter@ceb8a2b8f2d89434be7ff52d3de7ec3738c5cc9d # v4
        id: paths
        with:
          base: ${{ github.event_name == 'push' && github.event.before || github.event.repository.default_branch }}
          predicate-quantifier: some-with-excludes
          list-files: json
          filters: |
            docs:
              - '**/*.{md,mdx}'
            code:
              - '**'
              - '!**/*.{md,mdx}'

{% endraw %}
  platform-verify:
{% raw %}
    needs: changes
    if: ${{ needs.changes.outputs.code == 'true' || github.event_name == 'workflow_dispatch' }}
{% endraw %}
    name: platform-verify
    permissions:
      contents: read
      issues: write
{% if stack == 'unity' %}
    uses: {{ owner }}/dev-platform/.github/workflows/unity.yml@{{ platform_ref }}
    with:
      unity-runner: {{ unity_runner }}
      platform-ref: {{ platform_ref }}
{% if enable_codecov or unity_runner == 'uba' %}
    secrets:
{% if enable_codecov %}
      codecov_token: {% raw %}${{ secrets.CODECOV_TOKEN }}{% endraw %}
{% endif %}
{% if unity_runner == 'uba' %}
      unity_build_api_key: {% raw %}${{ secrets.UNITY_BUILD_API_KEY }}{% endraw %}
      unity_build_org_id: {% raw %}${{ secrets.UNITY_BUILD_ORG_ID }}{% endraw %}
      unity_build_project_id: {% raw %}${{ secrets.UNITY_BUILD_PROJECT_ID }}{% endraw %}
{% endif %}
{% endif %}
{% else %}
    uses: {{ owner }}/dev-platform/.github/workflows/ci.yml@{{ platform_ref }}
    with:
      run-tests: {{ 'false' if stack == 'other' and not run_tests else 'true' }}
      enable-codecov: {{ 'true' if enable_codecov and stack != 'other' else 'false' }}
      working-directory: "."
    secrets:
      codecov_token: {% raw %}${{ secrets.CODECOV_TOKEN }}{% endraw %}
{% endif %}

  platform-security:
{% raw %}
    needs: changes
    if: ${{ needs.changes.outputs.code == 'true' || github.event_name == 'workflow_dispatch' }}
{% endraw %}
    name: platform-security
    permissions:
      contents: read
      issues: write
      security-events: write
      actions: read
    uses: {{ owner }}/dev-platform/.github/workflows/security.yml@{{ platform_ref }}
    with:
      upload-sarif: {{ 'true' if visibility == 'public' else 'false' }}

{% raw %}
  platform-docs:
    name: platform-docs
    needs: changes
    if: ${{ needs.changes.outputs.docs == 'true' }}
    permissions:
      contents: read
    uses: {% endraw %}{{ owner }}{% raw %}/dev-platform/.github/workflows/docs.yml@{% endraw %}{{ platform_ref }}{% raw %}
    with:
      files-json: ${{ needs.changes.outputs.docs_files }}
      platform-ref: {% endraw %}{{ platform_ref }}{% raw %}

  quality-gate:
    name: quality-gate
    if: always()
    needs: [changes, platform-verify, platform-security, platform-docs]
    runs-on: ubuntu-latest
    steps:
      - name: Verify required jobs
        shell: bash
        env:
          EVENT: ${{ github.event_name }}
          CHANGES: ${{ needs.changes.result }}
          CODE: ${{ needs.changes.outputs.code }}
          DOCS: ${{ needs.changes.outputs.docs }}
          VERIFY: ${{ needs.platform-verify.result }}
          SECURITY: ${{ needs.platform-security.result }}
          DOC_CHECK: ${{ needs.platform-docs.result }}
        run: |
          set -euo pipefail
          test "$CHANGES" = success
          if [[ "$CODE" = true || "$EVENT" = workflow_dispatch ]]; then
            test "$VERIFY" = success && test "$SECURITY" = success
          fi
          if [[ "$DOCS" = true ]]; then
            test "$DOC_CHECK" = success
          fi{% endraw %}
