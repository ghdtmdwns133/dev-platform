name: CI

on:
  push:
    branches: ["**"]
    paths-ignore:
      - docs/**
      - "**/*.md"
  pull_request:
    paths-ignore:
      - docs/**
      - "**/*.md"
  workflow_dispatch: {}

permissions:
  contents: read

concurrency:
  group: {% raw %}ci-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  platform-verify:
    name: platform-verify
    permissions:
      contents: read
      issues: write
{% if stack == 'unity' %}
    uses: {{ owner }}/dev-platform/.github/workflows/unity.yml@{{ platform_ref }}
    with:
      unity-runner: {{ 'none' if visibility == 'public' else 'self-hosted' }}
      platform-ref: {{ platform_ref }}
    secrets:
      codecov_token: {% raw %}${{ secrets.CODECOV_TOKEN }}{% endraw %}
{% else %}
    uses: {{ owner }}/dev-platform/.github/workflows/ci.yml@{{ platform_ref }}
    with:
      run-tests: {{ 'false' if stack == 'other' else 'true' }}
      enable-codecov: {{ 'true' if enable_codecov and stack != 'other' else 'false' }}
      working-directory: "."
    secrets:
      codecov_token: {% raw %}${{ secrets.CODECOV_TOKEN }}{% endraw %}
{% endif %}

  platform-security:
    name: platform-security
    permissions:
      contents: read
      issues: write
      security-events: write
      actions: read
    uses: {{ owner }}/dev-platform/.github/workflows/security.yml@{{ platform_ref }}
    with:
      upload-sarif: {{ 'true' if visibility == 'public' else 'false' }}
