{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "Automerge minor, patch and digest updates.",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "Pin GitHub Actions to immutable commit digests.",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "Group Copier template updates into one pull request.",
      "matchManagers": ["copier"],
      "groupName": "copier template"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  }
}
